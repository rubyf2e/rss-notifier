# 複製此檔案為 .env 後即可直接執行 `docker compose up`
# cp .env.example .env

### PostgreSQL ###
POSTGRES_USER=rss_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rss_feed_notifier
POSTGRES_PORT=5432

### Redis ###
REDIS_PORT=6379

### Backend (NestJS) ###
BACKEND_PORT=3000
PORT=3000
BACKEND_URL=http://localhost:3000
DATABASE_URL=postgresql://rss_user:change_me@postgres:5432/rss_feed_notifier?schema=public
REDIS_URL=redis://redis:6379

# SMTP 郵件服務設定 (Ethereal)
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="訂閱通知"

# JWT 設定
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Magic Link 設定
MAGIC_LINK_TTL_MINUTES=15
FRONTEND_URL=http://localhost:3001

# Feed 同步排程間隔（分鐘）；未設定或設為 0、負數、非數字時預設為 15
FEED_SYNC_INTERVAL_MINUTES=15

# 每個 Feed 保留的最新 Article 數量
ARTICLE_RETENTION_PER_FEED=5

### Frontend (Nuxt) ###
FRONTEND_PORT=3001
NUXT_PUBLIC_API_BASE=http://localhost:3000
